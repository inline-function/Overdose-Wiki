{
  "id": "ch01.perception",
  "kind": "perception",
  "title": "把字按住",
  "subtitle": "第五高原",
  "intro": "手机屏幕上的字在动。按住它们，读出一句完整的话。松开，它们又会散。",
  "closing": "“余晖”真的存在吗？他不敢回答。",
  "doneLabel": "把手机扣下",
  "lines": [
    {
      "id": "p1",
      "text": "是解离性麻醉。",
      "note": "第一句还算清楚。"
    },
    {
      "id": "p2",
      "text": "手机上的字在动，像小虫子。",
      "note": "第二句开始变形。"
    },
    {
      "id": "p3",
      "text": "“余晖”真的存在吗？",
      "note": "最后一句，他不敢读完。"
    }
  ]
}
