  "words": [
    {
      "id": "w1",
      "text": "余晖",
      "note": "他抓住“余晖”两个字，字在指缝里散了。",
      "x": 7,
      "y": 16
    },
    {
      "id": "w2",
      "text": "五感在融化",
      "note": "五感像蜡一样塌下去。",
      "x": 56,
      "y": 13
    },
    {
      "id": "w3",
      "text": "时间不是线",
      "note": "时间被拉成一条很细的线。",
      "x": 27,
      "y": 32
    },
    {
      "id": "w4",
      "text": "我是谁",
      "note": "名字在舌头上化掉。",
      "x": 70,
      "y": 34
    },
    {
      "id": "w5",
      "text": "像小虫子",
      "note": "字在屏幕上爬。",
      "x": 8,
      "y": 55
    },
    {
      "id": "w6",
      "text": "这不是高原",
      "note": "他不知道自己站在哪里。",
      "x": 47,
      "y": 56
    },
    {
      "id": "w7",
      "text": "别回答",
      "note": "有人在很远的地方问他。",
      "x": 22,
      "y": 76
    },
    {
      "id": "w8",
      "text": "我在看",
      "note": "屏幕背面好像也有一双眼睛。",
