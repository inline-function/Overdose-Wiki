{
  "id": "ch02.voices",
  "kind": "voice-filter",
  "title": "声音：把缠住她的按灭",
  "subtitle": "命令性幻听",
  "intro": "声音从墙里、从天花板、从她自己的后脑勺里冒出来。它们不是都要被相信；先把它们一条条按灭。",
  "closing": "声音没有全消失，但屏幕空出来了。她终于能听见自己呼吸。",
  "doneLabel": "把耳朵还给她",
  "image": "assets-private/bg/bg_ch02_voices.png",
  "voices": [
    {
      "id": "v01",
      "text": "去死。"
    },
    {
      "id": "v02",
      "text": "你不配活着。"
    },
    {
      "id": "v03",
      "text": "割下去。"
    },
    {
      "id": "v04",
      "text": "从窗户跳下去。"
    },
    {
      "id": "v05",
      "text": "撞墙。"
    },
    {
      "id": "v06",
      "text": "别呼吸了。"
    },
    {
      "id": "v07",
      "text": "没有人会来。"
    },
    {
      "id": "v08",
      "text": "他在骗你。"
    },
    {
      "id": "v09",
      "text": "你只是负担。"
    },
    {
      "id": "v10",
      "text": "这具身体不是你的。"
    },
    {
      "id": "v11",
      "text": "你不是真的。"
    },
    {
      "id": "v12",
      "text": "他们都在笑你。"
    },
    {
      "id": "v13",
      "text": "别说话。"
    },
    {
      "id": "v14",
      "text": "你不该被救。"
    },
    {
      "id": "v15",
      "text": "回高原去。"
    },
    {
      "id": "v16",
      "text": "把皮肤撕开。"
    },
    {
      "id": "v17",
      "text": "你早就死了。"
    },
    {
      "id": "v18",
      "text": "别相信后藤。"
    },
    {
      "id": "v19",
      "text": "你会害死她。"
    },
    {
      "id": "v20",
      "text": "安静。"
    },
    {
      "id": "v21",
      "text": "你不配吃饭。"
    },
    {
      "id": "v22",
      "text": "跳。"
    },
    {
      "id": "v23",
      "text": "现在。"
    },
    {
      "id": "v24",
      "text": "把眼睛闭上，别再睁开。"
    }
  ]
}
